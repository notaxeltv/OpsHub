# Environment
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://opshub:opshub@localhost:5432/opshub?schema=public

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_starter_placeholder
STRIPE_PRICE_PRO=price_pro_placeholder

# Logging / Sentry
SENTRY_DSN=
